{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wine-tasting",
  "main": "./worker/index.ts",
  // Past 2025-04-01, so navigation requests are served straight from static
  // assets and never reach the Worker. Only /api/* costs an invocation.
  "compatibility_date": "2026-09-06",
  "assets": {
    // Do NOT set "directory" — the Vite plugin fills it from the client build.
    // Do NOT set "run_worker_first" — on the free tier it turns free asset
    // requests into billable invocations that 429. See ADR-0001.
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wine-tasting",
      // Local dev works with this placeholder — miniflare keys its local D1 off
      // the binding name. `wrangler deploy` does NOT: run
      //   wrangler d1 create wine-tasting
      // and paste the real id here first.
      "database_id": "local-only-run-wrangler-d1-create-before-deploy"
    }
  ]
}
